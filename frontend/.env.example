# Frontend environment (copy to .env.local and adjust)

# Backend REST API base URL
VITE_API_URL=http://localhost:8080/api

# Foundry VTT client URL embedded in the in-app Combat view (iframe).
# Use the Cloudflare Tunnel hostname of your Foundry instance, e.g.
# https://foundry.example.com. Must be served under the same parent domain as
# the app so the Foundry session cookie works inside the iframe.
# See openspec/specs/foundry-integration.md.
VITE_FOUNDRY_URL=http://localhost:30000
