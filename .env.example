# Copy to .env and adjust. scripts/lan-up.ps1 generates it automatically.
# Required: at least 32 random characters.
JWT_SECRET=replace-with-a-long-random-secret-of-32-chars-or-more

# Port the app listens on in the LAN (http://<host-ip>:APP_PORT)
APP_PORT=8080

# Database credentials (must match the existing volume if you reuse one)
POSTGRES_DB=dndmanager
POSTGRES_USER=dnduser
POSTGRES_PASSWORD=dndsharp
# Named volume for PostgreSQL data (default reuses the dev stack's database)
DB_VOLUME=infra_pgdata

# Optional: Ollama for the lore Oracle (start with --profile ai, or point to another host)
# OLLAMA_BASE_URL=http://192.168.1.50:11434

# Optional: extra allowed origins (comma-separated) when the SPA is served elsewhere
# ALLOWED_ORIGINS=http://localhost:5173

# Optional: Foundry VTT relay (only for campaigns in "foundry" mode)
# FOUNDRY_API_KEY=
# FOUNDRY_CLIENT_ID=
